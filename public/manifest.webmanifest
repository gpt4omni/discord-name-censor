{
  "name": "censor · hide your name in discord screenshots",
  "short_name": "censor",
  "description": "hide your name and avatar in discord screenshots before you share them. runs in your browser.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#bcd3f2",
  "theme_color": "#e56aa5",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "images", "accept": ["image/*"] }]
    }
  }
}
